/* ============================================================
   FUNCTION: itsm.fn_CheckUserGroupMembership
   Amaç: Kullanıcının ilgili atama grubunda aktif üyeliği olup 
         olmadığını kontrol eder (1 veya 0 döndürür).
   ============================================================ */

CREATE FUNCTION itsm.fn_CheckUserGroupMembership
(
    @UserId BIGINT,
    @AssignmentGroupId BIGINT
)
RETURNS BIT
WITH SCHEMABINDING
AS
BEGIN
    DECLARE @IsMember BIT = 0;

    IF EXISTS 
    (
        SELECT 1 
        FROM itsm.AssignmentGroupMembers agm
        WHERE agm.UserId = @UserId
          AND agm.AssignmentGroupId = @AssignmentGroupId
          AND (agm.LeftAt IS NULL OR agm.LeftAt > SYSUTCDATETIME())
    )
    BEGIN
        SET @IsMember = 1;
    END;

    RETURN @IsMember;
END;
GO